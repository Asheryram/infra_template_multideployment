# Monolith: one container serves pages + API (Rails, Django, Laravel, Next.js full-stack, Spring MVC...).
# → shop.<domain>, shop-staging.<domain>, shop-pr-42.<domain>
APP_NAME=shop
TYPE=monolith
IMAGE_REPO=ghcr.io/your-org/shop

APP_CONTEXT=.
APP_PORT=3000
APP_MEM_LIMIT=768m
APP_CPUS=1.0
PREVIEW_MEM_LIMIT=384m

NEEDS_DB=true
DB_PREVIEW_SOURCE=template
MIGRATE_CMD='npm run db:migrate'
