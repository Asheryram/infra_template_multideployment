# Split: frontend and backend live in ONE repo (e.g. /frontend + /backend), deployed together.
# → web: shop.<domain>        api: api-shop.<domain>
#   web gets API_URL=https://api-shop[-env].<domain>, api gets FRONTEND_URL (for CORS).
APP_NAME=shop
TYPE=split
IMAGE_REPO=ghcr.io/your-org/shop

WEB_CONTEXT=./frontend
WEB_PORT=80
WEB_MEM_LIMIT=128m
WEB_CPUS=0.5

API_CONTEXT=./backend
API_PORT=8080
API_MEM_LIMIT=512m
API_CPUS=1.0

# Database: off by default. Run `infra db create shop <env>` when a branch needs one,
# then set DATABASE_URL in the console for that environment.
MIGRATE_CMD='python manage.py migrate --noinput'
MIGRATE_SERVICE=api
