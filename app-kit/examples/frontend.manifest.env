# Frontend in its own repo, talking to the backend repo "shop-api".
# → shop-web.<domain>, shop-web-pr-12.<domain>
#
# Which API does a preview use?
#   1. a shop-api preview built from the SAME BRANCH NAME (feature/login ↔ feature/login)
#   2. otherwise shop-api's BACKEND_FALLBACK_ENV (develop)
# If the matching backend preview appears later, this frontend is relinked automatically;
# when it's destroyed, the frontend falls back again.
APP_NAME=shop-web
TYPE=frontend
IMAGE_REPO=ghcr.io/your-org/shop-web

WEB_CONTEXT=.
WEB_DOCKERFILE=./Dockerfile
WEB_PORT=80
WEB_MEM_LIMIT=128m
WEB_CPUS=0.5

BACKEND_APP=shop-api
BACKEND_FALLBACK_ENV=develop
