# Frontend in its own repo. Configure its API URL in .deploy/env files or server-side variables.
# → shop-web.<domain>, shop-web-pr-12.<domain>
APP_NAME=shop-web
TYPE=frontend
IMAGE_REPO=ghcr.io/your-org/shop-web

WEB_CONTEXT=.
WEB_DOCKERFILE=./Dockerfile
WEB_PORT=80
WEB_MEM_LIMIT=128m
WEB_CPUS=0.5
