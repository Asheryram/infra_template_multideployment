# Backend in its own repo. Configure any frontend's API URL explicitly in that frontend's env.
# → shop-api.<domain>, shop-api-develop.<domain>, shop-api-pr-7.<domain>
APP_NAME=shop-api
TYPE=backend
IMAGE_REPO=ghcr.io/your-org/shop-api

API_CONTEXT=.
API_PORT=8080

# Database: off by default. Run `infra db create shop-api <env>` when a branch needs one,
# then set DATABASE_URL in the console for that environment.
MIGRATE_CMD='./bin/migrate up'

# CORS hint for your code: allow https://*.${INFRA_DOMAIN} in non-prod environments.
