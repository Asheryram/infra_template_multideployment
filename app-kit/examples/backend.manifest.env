# Backend in its own repo. Pair it with a frontend repo whose BACKEND_APP=shop-api.
# → shop-api.<domain>, shop-api-develop.<domain>, shop-api-pr-7.<domain>
APP_NAME=shop-api
TYPE=backend
IMAGE_REPO=ghcr.io/your-org/shop-api

API_CONTEXT=.
API_PORT=8080
API_MEM_LIMIT=512m
API_CPUS=1.0
PREVIEW_MEM_LIMIT=256m

NEEDS_DB=true
DB_PREVIEW_SOURCE=template
MIGRATE_CMD='./bin/migrate up'

# CORS hint for your code: allow https://*.${INFRA_DOMAIN} in non-prod environments.
