# Non-secret config for ALL environments. Committed to git.
# Secrets (API keys, passwords) go to DevOps: `sudo infra secrets edit <app> <env>`.
# Precedence (later wins): infra-injected < common.env < <class>.env < <class>.<component>.env < server secrets
#
# Injected automatically: APP_NAME APP_ENV ENV_CLASS IS_PREVIEW PORT PUBLIC_URL INFRA_DOMAIN
#                         IMAGE_TAG GIT_BRANCH GIT_COMMIT
# DATABASE_URL, API_URL and FRONTEND_URL are app config; define them here or in server secrets.
LOG_LEVEL=info
TZ=UTC
