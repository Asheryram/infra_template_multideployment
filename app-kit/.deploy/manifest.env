# =============================================================================
#  .deploy/manifest.env — tells the infra platform how to run this repo.
#  Plain bash KEY=value. Quote values with spaces or $ in 'single quotes'.
#  Ready-made versions per project type: app-kit/examples/
# =============================================================================

# --- identity ----------------------------------------------------------------
# Unique on the server; lowercase, digits, dashes, max 30 chars. Becomes the hostname.
APP_NAME=myapp

# monolith → one container            (component: app)
# frontend → static/SSR frontend      (component: web)  pairs with a separate backend repo
# backend  → API only                 (component: api)
# split    → web + api in one repo    (components: web, api)
TYPE=monolith

# Images are pushed/pulled as ${IMAGE_REPO}/<component>:<tag>. Must be lowercase.
IMAGE_REPO=ghcr.io/your-org/myapp

# --- build (read by CI) ------------------------------------------------------
# <COMPONENT>_CONTEXT: build context; <COMPONENT>_DOCKERFILE: path from repo root
# (default: <context>/Dockerfile). Set <COMPONENT>_IMAGE to skip building and use
# a fixed image ("{tag}" is replaced with the deploy tag).
APP_CONTEXT=.
# WEB_CONTEXT=./frontend
# API_CONTEXT=./backend
# API_DOCKERFILE=./backend/Dockerfile.prod

# --- runtime -------------------------------------------------------------------
# Port the container listens on (also passed in as $PORT).
APP_PORT=3000
# WEB_PORT=80
# API_PORT=8080

# Resource caps (one leaky preview must never starve prod).
APP_MEM_LIMIT=512m
APP_CPUS=1.0
# PREVIEW_MEM_LIMIT=256m       # override for every component in pr-* environments

# --- database ----------------------------------------------------------------
# Deploy never creates or wires a database automatically.
# When a branch needs one:
#   1. infra db create <app> <env>     — spins up an isolated DB for that branch
#   2. infra db url <app> <env>        — prints the connection URL
#   3. Paste the URL into the console as DATABASE_URL (or whatever var the app reads)
# To point an env at another branch's DB, just set DATABASE_URL to that branch's URL.
# Runs in a one-off container of the new image BEFORE it goes live. Must be idempotent.
MIGRATE_CMD=''
# MIGRATE_SERVICE=api

# --- preview limits -----------------------------------------------------------
# Cap the number of open previews for this specific app (independent of the global
# MAX_PREVIEWS limit in the inventory). Useful when one busy repo would otherwise
# consume all preview slots on a shared server.
# MAX_PREVIEWS_PER_APP=3

# --- required variables -------------------------------------------------------
# Keys each component MUST have (from .deploy/env or server-side secrets). If one is
# missing, the deploy is blocked before anything changes and the console shows what to add.
# Adding a feature that needs a new secret? Add its key here in the same PR.
# API_REQUIRED_ENV="STRIPE_SECRET_KEY JWT_SECRET"
# WEB_REQUIRED_ENV=""
# APP_REQUIRED_ENV=""

# --- frontend → backend URL (TYPE=frontend) -------------------------------------
# DEFAULT: nothing automatic. The frontend's API URL is an ordinary env var (VITE_API_URL,
# NEXT_PUBLIC_API_URL, …) that DevOps sets per environment in the console
# (Environments → Manage → Environment variables).
#
# OPTIONAL auto-wiring: set BACKEND_APP and the platform fills API_URL_VAR for you. A preview
# then uses the backend preview from the SAME BRANCH NAME, else BACKEND_FALLBACK_ENV. Other envs
# use the backend's same env. A console value for the same key always wins.
# BACKEND_APP=myapp-api
# BACKEND_FALLBACK_ENV=develop
# API_URL_VAR=VITE_API_URL                   # which variable to fill (default: API_URL)
# API_URL_PROD=https://api.partner.com      # hard override per env class

# --- routing -------------------------------------------------------------------
# Custom host per env class: <COMPONENT>_HOST_<CLASS>
# WEB_HOST_PROD=www.example.com
# Basic-auth on previews (web/app). APIs are exempt unless API_PREVIEW_AUTH=true.
# PREVIEW_AUTH=true
# Extra Traefik middlewares, comma-separated (e.g. rate-limit@file)
# EXTRA_MIDDLEWARES=
