# Optional sidecars, merged into EVERY environment of this app.
# Rename to compose.extra.yml to enable. Each environment gets its own copy
# (a pr-42 redis is separate from prod's).
#
# Available variables: ${STACK} ${APP} ${ENV_NAME} ${TAG} ${DOMAIN}
#                      ${APP_IMAGE} ${WEB_IMAGE} ${API_IMAGE} (whichever exist)
# Relative paths resolve against the environment's directory, so
# runtime/api.env is the same env file the api container gets.
#
# Rules: no `ports:` (use Traefik labels), always set mem_limit and logging.
# Don't set `networks:` — every service lands on this environment's own private network
# (Postgres is reachable there only if the app uses the platform DB; other apps can't see it).
services:
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: ["redis-server", "--maxmemory", "64mb", "--maxmemory-policy", "allkeys-lru", "--save", ""]
    mem_limit: 96m
    logging:
      driver: json-file
      options: { max-size: "10m", max-file: "3" }

  # Background worker running the same image as the API.
  worker:
    image: ${API_IMAGE}
    command: ["npm", "run", "worker"]
    restart: unless-stopped
    init: true
    env_file: [runtime/api.env]
    environment:
      REDIS_URL: redis://redis:6379
    mem_limit: 256m
    logging:
      driver: json-file
      options: { max-size: "10m", max-file: "3" }

  # Extend a generated service: merged with templates/components/api.yml
  api:
    environment:
      REDIS_URL: redis://redis:6379
