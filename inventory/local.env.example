# =============================================================================
#  Inventory: LOCAL Multipass "fake VPS".
#  local/up.ps1 copies this to inventory/local.env and fills in DOMAIN for you.
#  Copied to /etc/infra/infra.env by bootstrap — re-run step 50 after edits:
#    sudo bash bootstrap/install.sh inventory/local.env 50
# =============================================================================

SERVER_NAME=fake-vps

# sslip.io resolves <anything>.172-25-1-10.sslip.io to 172.25.1.10 — a free
# wildcard DNS that needs no setup. Use the VM's IP with dots replaced by dashes.
DOMAIN=REPLACE-ME.sslip.io

# selfsigned: Let's Encrypt can't reach a private VM. Browsers will warn once per host.
TLS_MODE=selfsigned

TIMEZONE=UTC
SWAP_SIZE=1G
ADMIN_USER=ubuntu
DEPLOY_USER=deploy

# Basic-auth for ops tools and previews. *_PLAIN is hashed at `platform up`.
# On a real server, prefer *_USERS with an htpasswd line (htpasswd -nbB user pass).
DASHBOARD_AUTH_PLAIN='admin:admin'
PREVIEW_AUTH_ENABLED=true
PREVIEW_AUTH_PLAIN='preview:preview'

# local-registry: push images to 127.0.0.1:5000 inside the VM instead of GHCR.
PLATFORM_PROFILES=local-registry

# Size this like the VPS you'll buy to learn the real capacity.
MAX_PREVIEWS=6
PREVIEW_TTL_DAYS=3
BACKUP_RETENTION_DAYS=3
DISK_ALERT_PCT=85
ALERT_WEBHOOK_URL=
