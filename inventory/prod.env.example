# =============================================================================
#  Inventory: REAL VPS. Copy to inventory/<server>.env (gitignored) and fill in.
#  Non-secret settings only — secrets go in /etc/infra/platform.secrets.env.
# =============================================================================

SERVER_NAME=vps-1

# shared     (default) the server already runs other people's apps/DBs — we never touch
#            host-wide settings (sshd, firewall defaults, Docker daemon, journald, sysctl).
# dedicated  the server is ours alone — full hardening. Refused if foreign containers exist.
HOST_MODE=shared

# Prefix for our compose projects/containers (infra-shop-prod-app-1) — avoids name clashes.
STACK_PREFIX=infra

# Who owns ports 80/443?
#   free → Traefik takes them:            TRAEFIK_BIND=0.0.0.0 TRAEFIK_HTTP_PORT=80 TRAEFIK_HTTPS_PORT=443
#   an existing nginx/apache owns them → TLS_MODE=external, TRAEFIK_BIND=127.0.0.1,
#   TRAEFIK_HTTPS_PORT=8443, and forward *.DOMAIN from that proxy (docs/shared-host.md)
TRAEFIK_BIND=0.0.0.0
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Every environment lives one level under this domain:
#   prod      shop.apps.example.com          api-shop.apps.example.com
#   staging   shop-staging.apps.example.com
#   preview   shop-pr-42.apps.example.com
# DNS: A records for apps.example.com AND *.apps.example.com → server IP.
DOMAIN=apps.example.com

# letsencrypt: wildcard cert via DNS challenge (token in /etc/infra/traefik.env)
# external:    the host's existing proxy terminates TLS (see TRAEFIK_* above)
TLS_MODE=letsencrypt
ACME_EMAIL=devops@example.com
DNS_PROVIDER=cloudflare
# While testing, use LE staging to avoid rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

TIMEZONE=UTC
SWAP_SIZE=2G
AUTO_REBOOT=false

# ADMIN_* only used for SSH hardening in HOST_MODE=dedicated
ADMIN_USER=ubuntu
ADMIN_SSH_PUBKEY='ssh-ed25519 AAAA... you@laptop'
# Must not already exist on the server (preflight checks). "deploy" is a common name —
# pick something specific on shared hosts.
DEPLOY_USER=infradeploy
# Only needed if CI deploys over SSH instead of the self-hosted runner:
DEPLOY_SSH_PUBKEY=

# htpasswd lines: htpasswd -nbB admin 'long-random-password'
DASHBOARD_AUTH_USERS='admin:$2y$05$REPLACE_WITH_REAL_HASH'
PREVIEW_AUTH_ENABLED=true
PREVIEW_AUTH_USERS='preview:$2y$05$REPLACE_WITH_REAL_HASH'

# Comma-separated: metrics (Prometheus+Grafana, ~400 MB RAM)
PLATFORM_PROFILES=

# Registry the server pulls from. Token (read:packages) goes in platform.secrets.env.
REGISTRY=ghcr.io
REGISTRY_USER=your-bot-account

# Capacity guard rails — roughly (RAM_GB - 2) / 0.5 for typical small previews.
MAX_PREVIEWS=8
PREVIEW_TTL_DAYS=7

# App resource policy defaults and hard ceilings (memory values require k/m/g suffixes).
# Per-app scope overrides are configured in the Infra Console and cannot exceed
# either the per-container or per-deployment-stack ceiling.
RESOURCE_DEFAULT_MEM_LIMIT=512m
RESOURCE_DEFAULT_CPUS=1.0
RESOURCE_PREVIEW_MEM_LIMIT=256m
RESOURCE_PREVIEW_CPUS=0.5
RESOURCE_MAX_CONTAINER_MEM_LIMIT=1g
RESOURCE_MAX_CONTAINER_CPUS=2.0
RESOURCE_MAX_STACK_MEM_LIMIT=2g
RESOURCE_MAX_STACK_CPUS=3.0

BACKUP_RETENTION_DAYS=7
DISK_ALERT_PCT=80
MEM_ALERT_AVAIL_PCT=10
ALERT_REPEAT_MINUTES=60
# Slack / Discord / Teams / Mattermost incoming webhook
ALERT_WEBHOOK_URL=

# Pin platform images once tested (examples):
# TRAEFIK_IMAGE=traefik:v3.3
# POSTGRES_IMAGE=postgres:16-alpine
# POSTGRES_MEM_LIMIT=1g
