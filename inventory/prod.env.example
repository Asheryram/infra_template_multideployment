# =============================================================================
#  Inventory: REAL VPS. Copy to inventory/<server>.env (gitignored) and fill in.
#  Non-secret settings only — secrets go in /etc/infra/platform.secrets.env.
# =============================================================================

SERVER_NAME=vps-1

# Every environment lives one level under this domain:
#   prod      shop.apps.example.com          api-shop.apps.example.com
#   staging   shop-staging.apps.example.com
#   preview   shop-pr-42.apps.example.com
# DNS: A records for apps.example.com AND *.apps.example.com → server IP.
DOMAIN=apps.example.com

# Wildcard cert via DNS challenge. Put the provider token in /etc/infra/traefik.env.
TLS_MODE=letsencrypt
ACME_EMAIL=devops@example.com
DNS_PROVIDER=cloudflare
# While testing, use LE staging to avoid rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

TIMEZONE=UTC
SWAP_SIZE=2G
AUTO_REBOOT=false

ADMIN_USER=ubuntu
ADMIN_SSH_PUBKEY='ssh-ed25519 AAAA... you@laptop'
DEPLOY_USER=deploy
# Only needed if CI deploys over SSH instead of the self-hosted runner:
DEPLOY_SSH_PUBKEY=

# htpasswd lines: htpasswd -nbB admin 'long-random-password'
DASHBOARD_AUTH_USERS='admin:$2y$05$REPLACE_WITH_REAL_HASH'
PREVIEW_AUTH_ENABLED=true
PREVIEW_AUTH_USERS='preview:$2y$05$REPLACE_WITH_REAL_HASH'

# Comma-separated: metrics (Prometheus+Grafana, ~400 MB RAM)
PLATFORM_PROFILES=

# Registry the server pulls from. Token (read:packages) goes in platform.secrets.env.
REGISTRY=ghcr.io
REGISTRY_USER=your-bot-account

# Capacity guard rails — roughly (RAM_GB - 2) / 0.5 for typical small previews.
MAX_PREVIEWS=8
PREVIEW_TTL_DAYS=7

BACKUP_RETENTION_DAYS=7
DISK_ALERT_PCT=80
MEM_ALERT_AVAIL_PCT=10
ALERT_REPEAT_MINUTES=60
# Slack / Discord / Teams / Mattermost incoming webhook
ALERT_WEBHOOK_URL=

# Pin platform images once tested (examples):
# TRAEFIK_IMAGE=traefik:v3.3
# POSTGRES_IMAGE=postgres:16-alpine
# POSTGRES_MEM_LIMIT=1g
