# /etc/infra/platform.secrets.env — created by bootstrap (root:deploy 0640).
# Never commit the real file.

# Superuser for the shared Postgres (generated on first bootstrap).
POSTGRES_PASSWORD=@GENERATED@

# Authentik uses a dedicated database role and its own signing/encryption key.
AUTHENTIK_POSTGRES_PASSWORD=@AUTHENTIK_DB_PASSWORD@
AUTHENTIK_SECRET_KEY=@AUTHENTIK_SECRET_KEY@
# Temporary first-run bootstrap only. Remove both after creating the Authentik admin.
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=

# Keycloak database/admin credentials and the oauth2-proxy OIDC client credentials.
KEYCLOAK_POSTGRES_PASSWORD=@KEYCLOAK_DB_PASSWORD@
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=@KEYCLOAK_ADMIN_PASSWORD@
OAUTH2_PROXY_CLIENT_SECRET=@OAUTH2_PROXY_CLIENT_SECRET@
OAUTH2_PROXY_COOKIE_SECRET=@OAUTH2_PROXY_COOKIE_SECRET@

# Registry pull token (GitHub PAT or fine-grained token with read:packages).
REGISTRY_TOKEN=

# Lets `infra cleanup` remove previews as soon as their PR is closed (repo read access).
GH_TOKEN=

# Off-server backups with restic (any backend: s3:, b2:, sftp:, rest:...).
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Only if PLATFORM_PROFILES includes metrics.
GRAFANA_ADMIN_PASSWORD=
