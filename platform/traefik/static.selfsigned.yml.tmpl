# Traefik static config — TLS_MODE=selfsigned (local Multipass VM, internal servers).
# Rendered by `infra platform render`; edit this template, not the output.
global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO
  format: json

accessLog:
  format: json
  fields:
    headers:
      defaultMode: drop

api:
  dashboard: true

ping:
  entryPoint: traefik

metrics:
  prometheus:
    entryPoint: metrics
    addEntryPointsLabels: true
    addServicesLabels: true

entryPoints:
  traefik:
    address: ":8080"
    http:
      aliasHeadersStrategy: reject
  web:
    address: ":80"
    http:
      aliasHeadersStrategy: reject
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
      aliasHeadersStrategy: reject
      tls: {}
    transport:
      respondingTimeouts:
        readTimeout: 120s
        writeTimeout: 120s
        idleTimeout: 180s
  metrics:
    address: ":8082"
    http:
      aliasHeadersStrategy: reject

# Rolling deploys: Traefik notices a container appearing or disappearing within 0.2 s instead of 2 s, and gives up on a
# container that has just vanished after 1 s instead of 30 s, so the retry middleware lands on a live copy.
serversTransport:
  forwardingTimeouts:
    dialTimeout: 1s

providers:
  providersThrottleDuration: 200ms
  docker:
    endpoint: "tcp://socket-proxy:2375"
    exposedByDefault: false
    network: infra_proxy
  file:
    directory: /etc/traefik/dynamic
    watch: true
