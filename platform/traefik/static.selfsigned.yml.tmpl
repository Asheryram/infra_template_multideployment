# Traefik static config — TLS_MODE=selfsigned (local Multipass VM, internal servers).
# Rendered by `infra platform render`; edit this template, not the output.
global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO
  format: json

accessLog:
  format: json
  fields:
    headers:
      defaultMode: drop

api:
  dashboard: true

ping: {}

metrics:
  prometheus:
    entryPoint: metrics
    addEntryPointsLabels: true
    addServicesLabels: true

entryPoints:
  traefik:
    address: ":8080"
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
      tls: {}
    transport:
      respondingTimeouts:
        readTimeout: 120s
        writeTimeout: 120s
        idleTimeout: 180s
  metrics:
    address: ":8082"

providers:
  docker:
    endpoint: "tcp://socket-proxy:2375"
    exposedByDefault: false
    network: infra_proxy
  file:
    directory: /etc/traefik/dynamic
    watch: true
