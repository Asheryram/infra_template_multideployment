# Shared middlewares, referenced by apps as <name>@file.
# Rendered by `infra platform render` into $STATE_DIR/traefik/dynamic/.
http:
  middlewares:
    secure-headers:
      headers:
        stsSeconds: ${HSTS_SECONDS}
        contentTypeNosniff: true
        referrerPolicy: strict-origin-when-cross-origin
        customFrameOptionsValue: SAMEORIGIN
        permissionsPolicy: "camera=(), microphone=(), geolocation=()"
        customResponseHeaders:
          Server: ""
          X-Powered-By: ""

    compress:
      compress: {}

    # Keeps previews out of search engines.
    preview-noindex:
      headers:
        customResponseHeaders:
          X-Robots-Tag: "noindex, nofollow"

    # Opt-in per app with EXTRA_MIDDLEWARES=rate-limit@file
    rate-limit:
      rateLimit:
        average: 50
        burst: 100

    # Public webhook endpoint (hooks.<domain>): generous for CI, hostile to floods.
    hook-limit:
      rateLimit:
        average: 5
        period: 1s
        burst: 20

    # Ops tools (Traefik dashboard, Dozzle).
    ops-auth:
      basicAuth:
        users: ["${DASHBOARD_AUTH_USERS}"]
        headerField: X-Infra-User          # the console records who did what

    # Ops tools behind Keycloak (OPS_AUTH_MODE=keycloak): only platform administrators pass. The console decides
    # (it asks the previews oauth2-proxy who is signed in); signed-out browsers are sent to Keycloak and back.
    ops-sso:
      forwardAuth:
        address: http://console:8000/auth/platform
        trustForwardHeader: true

    authentik-auth:
      forwardAuth:
        address: http://authentik-server:9000/outpost.goauthentik.io/auth/traefik
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-uid
          - X-authentik-username
          - X-authentik-email
          - X-authentik-name
          - X-authentik-groups

    authentik-vpn:
      ipAllowList:
        sourceRange:
${AUTHENTIK_VPN_CIDRS_YAML}

    keycloak-vpn:
      ipAllowList:
        sourceRange:
${KEYCLOAK_VPN_CIDRS_YAML}

    # Preview environments (web/app components).
    preview-auth:
      basicAuth:
        realm: "Preview environment"
        users: ["${PREVIEW_AUTH_USERS}"]

    # A service with `public: false` keeps no reachable address of its own; it is only served through the
    # `upstreams` routes of other services. Nothing is ever in 192.0.2.0/24 (TEST-NET-1), so this always answers 403.
    deny-all:
      ipAllowList:
        sourceRange: ["192.0.2.1/32"]
