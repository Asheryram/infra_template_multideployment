# Managed by infra bootstrap (bootstrap/files/cron). Times use the server TIMEZONE.
# Each job logs to /var/log/infra/<job>.log itself.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

*/10 * * * *  @DEPLOY_USER@  infra host-check >/dev/null 2>&1
15 2 * * *    @DEPLOY_USER@  infra backup     >/dev/null 2>&1
45 3 * * *    @DEPLOY_USER@  infra cleanup    >/dev/null 2>&1
