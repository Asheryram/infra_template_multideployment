{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3",
    "compress": "true"
  },
  "live-restore": true,
  "userland-proxy": false,
  "default-address-pools": [
    { "base": "10.201.0.0/16", "size": 24 }
  ],
  "max-concurrent-downloads": 3,
  "features": { "buildkit": true }
}
